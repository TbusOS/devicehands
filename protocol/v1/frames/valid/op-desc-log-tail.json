{
  "name": "log-tail",
  "group": "host",
  "summary": "last lines of a host-side log, by source name",
  "params": [
    {
      "name": "source",
      "kind": "enum",
      "required": true,
      "default": null,
      "choices": [
        "agent"
      ]
    },
    {
      "name": "lines",
      "kind": "int",
      "required": false,
      "default": 200,
      "min": 1,
      "max": 2000
    },
    {
      "name": "grep",
      "kind": "text",
      "required": false,
      "default": "",
      "pattern": "[^\\x00-\\x1f\\x7f]*",
      "max_len": 64
    }
  ],
  "needs": "",
  "image": false,
  "max_image_bytes": 0,
  "mutates": false,
  "exclusive": false,
  "record": "none",
  "timeout_s": 30.0
}
