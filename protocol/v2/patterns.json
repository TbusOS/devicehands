    },
    {
      "pattern": "[a--b]",
      "why": "-- inside a class is set difference in Rust"
    },
    {
      "pattern": "[a&&b]",
      "why": "&& inside a class is set intersection in Rust"
    },
    {
      "pattern": "\\bword\\b",
      "why": "word boundary"
    },
    {
      "pattern": "\\n",
