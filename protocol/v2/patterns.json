    },
    {
      "pattern": "\\u00e9",
      "why": "\\u escapes differ between languages"
    },
    {
      "pattern": "\u00e9",
      "why": "non-ASCII literal: write a class or \\xHH"
    },
    {
      "pattern": "[a-\\d]",
