{
  "name": "flash",
  "group": "fastboot",
  "summary": "fastboot flash <partition> <image>",
  "params": [
    {
      "name": "partition",
      "kind": "partition",
      "required": true,
      "default": null,
      "pattern": "[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}",
      "max_len": 64
    }
  ],
  "needs": "fastboot-device",
  "image": true,
  "max_image_bytes": 0,
  "mutates": true,
  "exclusive": true,
  "record": "uart",
  "timeout_s": 900.0
}
