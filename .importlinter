; Import direction check: dependencies may only point downward.
; Layer model: docs/devicehands-design.md section 5.1. Run: lint-imports
;
; Layer syntax (import-linter 2.x):
;   "a | b"  independent siblings: same layer, must NOT import each other.
;   "a : b"  non-independent siblings: same layer, may import each other.
; Skipping layers downward (e.g. cli -> infra) is allowed.
; Imports inside functions are checked too (grimp reads every import statement).
; Imports under "if TYPE_CHECKING:" are checked too (exclude_type_checking_imports
; is left at its default, False).
;
; ignore_imports is the allowlist of violations that existed when the check was
; added. Each entry is one exact module pair, no wildcards. Do not add entries
; for new code; remove an entry when its import is fixed. If an entry no longer
; matches a real import, the check fails (unmatched_ignore_imports_alerting =
; error), so the allowlist cannot silently go stale.

[importlinter]
root_package = devicehands

[importlinter:contract:layers]
name = Dependencies flow downward only
type = layers
layers =
    devicehands.cli | devicehands.mcp | devicehands.api | devicehands.skills
    devicehands.capabilities | devicehands.agent
    devicehands.transport
    devicehands.remote
    devicehands.infra
unmatched_ignore_imports_alerting = error
ignore_imports =
    ; --- lower layer imports upper layer (5 pairs) ---
    ; capabilities -> cli: doctor reuses probe helpers that live in the CLI package.
    devicehands.capabilities.doctor -> devicehands.cli._probes
    ; remote -> transport: the port channel builds on the adb socket client (top-level import).
    devicehands.remote.port_channel -> devicehands.transport.adb_socket
    ; infra -> remote: read the hub forwarder state in-process (lazy import in a function).
    devicehands.infra.adb_endpoint -> devicehands.remote.forwarder
    ; infra -> remote: read the agent registry in-process (lazy import in a function).
    devicehands.infra.adb_endpoint -> devicehands.remote.registry
    ; infra -> remote: read the serial forwarder snapshot in-process (lazy import in a function).
    devicehands.infra.hub_serial -> devicehands.remote.forwarder
    ; --- same-layer interface packages import each other (5 pairs) ---
    ; api -> mcp: the HTTP tools route registers the MCP tool set.
    devicehands.api.tools_route -> devicehands.mcp.tools
    ; api -> mcp: chat route builds agent tools from the MCP executor (lazy import).
    devicehands.api.chat_route -> devicehands.mcp.executor
    ; cli -> mcp: chat command builds agent tools from the MCP executor (lazy import).
    devicehands.cli.chat_cli -> devicehands.mcp.executor
    ; cli -> mcp: CLI transport construction lives in the MCP package.
    devicehands.cli.common -> devicehands.mcp.transport_factory
    ; cli -> skills: the skills command calls the skill generator.
    devicehands.cli.skills_cli -> devicehands.skills.generator
